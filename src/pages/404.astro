---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Not found">
  <div class="justify-between mx-auto p-4 text-center space-y-8">
    <h1 class="text-3xl">Not found</h1>
    <p class="text-lg">The page you are looking for does not exist.</p>
    <a href="/">
      <p class="text-blue-500 hover:underline">Go back to home page</p>
    </a>
  </div>
</Layout>
