---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = 'batchler.me' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content="Portfolio site for Corey Batchler" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Before first paint: the saved choice, else the OS preference. -->
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('darkMode'); } catch {}
        const dark = saved === null ? matchMedia('(prefers-color-scheme: dark)').matches : saved === 'true';
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="antialiased bg-white text-[#171717] dark:bg-gray-900 dark:text-white">
    <div class="max-w-3xl mx-auto p-4">
      <Navbar />
      <hr class="my-4" />
      <slot />
      <hr class="mt-16 mb-4" />
      <Footer />
    </div>
  </body>
</html>
